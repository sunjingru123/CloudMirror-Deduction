# 云镜推演 - 后端环境变量示例
# 复制为 .env 后按需修改；请勿将真实密钥或密码提交到仓库。

# 调试模式
DEBUG=true

# 数据库连接（默认 SQLite，文件生成在 backend 运行目录）
DATABASE_URL=sqlite:///./cloudmirror.db

# 接口前缀
API_PREFIX=/api

# 允许跨域的前端地址（逗号分隔，本地 Vue 开发服务器）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
